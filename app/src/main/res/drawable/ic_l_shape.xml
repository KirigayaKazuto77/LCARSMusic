<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="165dp"
    android:height="80dp"
    android:viewportWidth="165"
    android:viewportHeight="80">

    <!--
      Path Trace:
      M 0,0       : Start at top left
      L 125,0     : Draw top edge
      L 125,20    : Draw down to inner corner
      A 10,10...  : Carve out the 10px concave inner corner
      L 165,30    : Draw top of the right horizontal bar
      L 165,80    : Draw right edge
      L 80,80     : Draw bottom edge towards the outer curve
      A 80,80...  : Draw the 80px convex bottom-left curve
      Z           : Close path
    -->
    <path
        android:fillColor="#0000FF"
        android:pathData="M 0,0 L 125,0 A 30,30 0 0,0 155,30 L 165,30 L 165,80 L 80,80 A 80,80 0 0,1 0,0 Z" />
</vector>