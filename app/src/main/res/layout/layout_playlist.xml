<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:background="#000000" >

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="AVAILABLE PLAYLIST"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textScaleX="0.7"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_scan_playlists"
            android:layout_width="125dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_lcars_pill_button"
            android:backgroundTint="@color/lcars_classic_blue"
            android:fontFamily="sans-serif-condensed"
            android:gravity="bottom|end"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:stateListAnimator="@null"
            android:text="SCAN"
            android:textColor="#000000"
            android:textScaleX="0.7"
            android:textSize="23sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Playlist Body -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_playlist_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical" />

</LinearLayout>