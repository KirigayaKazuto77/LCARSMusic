<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/corner_tl" android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/frame_corner" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <ImageView android:id="@+id/corner_tr" android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/frame_corner" android:rotation="90" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <ImageView android:id="@+id/corner_bl" android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/frame_corner" android:rotation="270" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <ImageView android:id="@+id/corner_br" android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/frame_corner" android:rotation="180" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout android:id="@+id/left_column" android:layout_width="18.5dp" android:layout_height="0dp" android:orientation="vertical" android:weightSum="3" app:layout_constraintTop_toBottomOf="@id/corner_tl" app:layout_constraintBottom_toTopOf="@id/corner_bl" app:layout_constraintStart_toStartOf="parent">
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:background="#10B981" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="3dp" android:background="#10B981" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="3dp" android:background="#10B981" />
    </LinearLayout>

    <LinearLayout android:id="@+id/right_column" android:layout_width="18.5dp" android:layout_height="0dp" android:orientation="vertical" android:weightSum="3" app:layout_constraintTop_toBottomOf="@id/corner_tr" app:layout_constraintBottom_toTopOf="@id/corner_br" app:layout_constraintEnd_toEndOf="parent">
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:background="#10B981" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="3dp" android:background="#10B981" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="3dp" android:background="#10B981" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/left_column"
        app:layout_constraintEnd_toStartOf="@+id/right_column" />

</merge>