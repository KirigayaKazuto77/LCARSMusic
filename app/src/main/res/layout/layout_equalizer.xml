<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="10dp" >

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="EQUALIZER"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textScaleX="0.7"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_preset_selector"
                android:layout_width="125dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_lcars_pill_button"
                android:backgroundTint="@color/lcars_nemesis_moonbeam"
                android:fontFamily="sans-serif-condensed"
                android:gravity="bottom|end"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="30dp"
                android:stateListAnimator="@null"
                android:text="FLAT"
                android:textColor="#000000"
                android:textScaleX="0.7"
                android:textSize="23sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_reset_equalizer"
                android:layout_width="125dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_lcars_pill_button"
                android:backgroundTint="@color/lcars_nemesis_pumpkinshade"
                android:fontFamily="sans-serif-condensed"
                android:gravity="bottom|end"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:stateListAnimator="@null"
                android:text="RESET"
                android:textColor="#000000"
                android:textScaleX="0.7"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Equalizer Controls -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/equalizerBandsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

</LinearLayout>
