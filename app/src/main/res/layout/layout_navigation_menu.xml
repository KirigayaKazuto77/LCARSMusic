<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_visualizer_frequency_domain"
            android:layout_width="110dp"
            android:layout_height="100dp"
            android:layout_marginEnd="5dp"
            android:background="#88BBFF"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="28sp"
                android:layout_gravity="bottom|end"
                android:gravity="end"
                android:lineSpacingExtra="-4dp"
                android:scaleY="2.0"
                android:text="FREQUENCY\nDOMAIN"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_visualizer_time_domain"
            android:layout_width="110dp"
            android:layout_height="100dp"
            android:layout_marginEnd="5dp"
            android:background="#8899FF"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="28sp"
                android:layout_gravity="bottom|end"
                android:gravity="end"
                android:lineSpacingExtra="-4dp"
                android:scaleY="2.0"
                android:text="TIME\nDOMAIN"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageView
            android:layout_width="100dp"
            android:layout_height="150dp"
            android:src="@drawable/lcars_l_shape" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="10dp"
            android:layout_marginEnd="25dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btn_now_playing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">

                <View
                    android:id="@+id/tombstone_now_playing"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bttn_tombstone_left"
                    android:backgroundTint="#6699FF" />

                <FrameLayout
                    android:id="@+id/label_container_now_playing"
                    android:layout_width="120dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="5dp"
                    android:background="#5566ff"
                    android:paddingEnd="4dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/text_now_playing"
                        android:layout_width="wrap_content"
                        android:layout_height="18sp"
                        android:layout_gravity="bottom|end"
                        android:scaleY="2.0"
                        android:text="NOW PLAYING"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:gravity="fill_vertical|end"
                    android:scaleY="2.0"
                    android:text="99K"
                    android:textColor="#FFFFFF"
                    android:textSize="35sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="5dp"
                    android:background="#5588EE" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_library"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">

                <View
                    android:id="@+id/tombstone_library"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bttn_tombstone_left"
                    android:backgroundTint="#2266FF" />

                <FrameLayout
                    android:id="@+id/label_container_library"
                    android:layout_width="120dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="5dp"
                    android:background="#88BBFF"
                    android:paddingEnd="4dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/text_library"
                        android:layout_width="wrap_content"
                        android:layout_height="18sp"
                        android:layout_gravity="bottom|end"
                        android:scaleY="2.0"
                        android:text="LIBRARY"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:gravity="fill_vertical|end"
                    android:scaleY="2.0"
                    android:text="99K"
                    android:textColor="#FFFFFF"
                    android:textSize="35sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="5dp"
                    android:background="#66CCFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_playlist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">

                <View
                    android:id="@+id/tombstone_playlist"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bttn_tombstone_left"
                    android:backgroundTint="#4E81E0" />

                <FrameLayout
                    android:id="@+id/label_container_playlist"
                    android:layout_width="120dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="5dp"
                    android:background="#5566FF"
                    android:paddingEnd="4dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/text_playlist"
                        android:layout_width="wrap_content"
                        android:layout_height="18sp"
                        android:layout_gravity="bottom|end"
                        android:scaleY="2.0"
                        android:text="PLAYLIST"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:gravity="fill_vertical|end"
                    android:scaleY="2.0"
                    android:text="99K"
                    android:textColor="#FFFFFF"
                    android:textSize="35sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="5dp"
                    android:background="#99CCFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_equalizer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">

                <View
                    android:id="@+id/tombstone_equalizer"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bttn_tombstone_left"
                    android:backgroundTint="#88BBFF" />

                <FrameLayout
                    android:id="@+id/label_container_equalizer"
                    android:layout_width="120dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="5dp"
                    android:background="#8899FF"
                    android:paddingEnd="4dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/text_equalizer"
                        android:layout_width="wrap_content"
                        android:layout_height="18sp"
                        android:layout_gravity="bottom|end"
                        android:scaleY="2.0"
                        android:text="EQUALIZER"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:gravity="fill_vertical|end"
                    android:scaleY="2.0"
                    android:text="99K"
                    android:textColor="#FFFFFF"
                    android:textSize="35sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="5dp"
                    android:background="#5E5EF5" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="15dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="#9966CC" />

            <View
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="4dp"
                android:background="#FFA500" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>