<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="10dp" >

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/library_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_library_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="ALL SONGS"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textScaleX="0.7"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_scan_device"
            android:layout_width="125dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_lcars_pill_button"
            android:backgroundTint="@color/lcars_classic_blue"
            android:fontFamily="sans-serif-condensed"
            android:gravity="bottom|end"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:stateListAnimator="@null"
            android:text="SCAN"
            android:textColor="#000000"
            android:textScaleX="0.7"
            android:textSize="23sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Column Headers -->
    <LinearLayout
        android:id="@+id/library_column_headers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:padding="8dp">

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:text="SONG ID"
            android:textAllCaps="true"
            android:textColor="#AAAAAA"
            android:textSize="25sp"
            android:textScaleX="0.7"
            android:textAlignment="textEnd"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginStart="30dp"
            android:text="TITLE"
            android:textAllCaps="true"
            android:textColor="#AAAAAA"
            android:textSize="25sp"
            android:textScaleX="0.7"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ARTIST"
            android:textAllCaps="true"
            android:textColor="#AAAAAA"
            android:textSize="25sp"
            android:textScaleX="0.7"
            android:textStyle="bold" />

        <TextView
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:text="LENGTH"
            android:textAllCaps="true"
            android:textColor="#AAAAAA"
            android:textSize="25sp"
            android:textScaleX="0.7"
            android:textAlignment="textEnd"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Media List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_media_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>