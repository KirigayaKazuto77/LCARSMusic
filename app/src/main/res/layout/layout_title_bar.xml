<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <View
        android:id="@+id/y_bar"
        android:layout_width="125dp"
        android:layout_height="40dp"
        android:layout_marginBottom="5dp"
        android:background="#9966FF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/l_shape"
        app:layout_constraintVertical_chainStyle="packed" />

    <ImageView
        android:id="@+id/l_shape"
        android:layout_width="165dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_l_shape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/y_bar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextClock
        android:id="@+id/tc_time"
        android:layout_width="wrap_content"
        android:layout_height="62sp"
        android:layout_marginStart="5dp"
        android:format12Hour="hh:mm:ss aa"
        android:textColor="#FFFFFF"
        android:textSize="66sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:textScaleX="0.5"
        android:textAllCaps="true"
        android:includeFontPadding="false"
        android:gravity="fill_vertical"
        app:layout_constraintStart_toEndOf="@+id/l_shape"
        app:layout_constraintBottom_toBottomOf="@+id/x_bar" />

    <View
        android:id="@+id/x_bar"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="5dp"
        android:background="#0000FF"
        app:layout_constraintWidth_min="50dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tc_time"
        app:layout_constraintEnd_toStartOf="@+id/tv_view_title"
        app:layout_constraintBottom_toBottomOf="@+id/l_shape" />

    <TextView
        android:id="@+id/tv_view_title"
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:layout_marginStart="5dp"
        android:paddingTop="-50dp"
        android:text="VIEW TITLE"
        android:textColor="#FFFFFF"
        android:textSize="66sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:textAllCaps="true"
        android:singleLine="true"
        android:ellipsize="end"
        android:textScaleX="0.5"
        android:includeFontPadding="false"
        android:gravity="fill_vertical"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toEndOf="@+id/x_bar"
        app:layout_constraintEnd_toStartOf="@+id/tombstone"
        app:layout_constraintBottom_toBottomOf="@+id/x_bar" />

    <View
        android:id="@+id/tombstone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="5dp"
        android:backgroundTint="#66CCFF"
        android:background="@drawable/bttn_tombstone_right"
        app:layout_constraintStart_toEndOf="@+id/tv_view_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/l_shape" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_power"
        android:layout_width="125dp"
        android:layout_height="50dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_lcars_pill_button"
        android:backgroundTint="#CC2233"
        android:stateListAnimator="@null"
        android:text="POWER"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textScaleX="0.6"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:gravity="bottom|end"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tombstone" />

</androidx.constraintlayout.widget.ConstraintLayout>